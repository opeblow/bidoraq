    "viem": "^2.37.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.65.1",
    "postcss": "^8.4.49",
